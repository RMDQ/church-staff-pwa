# 设定参考表，不会自动被 Flutter / prepare-deployment.mjs 载入。
# 本机实际值放 gitignored .env 或 .local/；CI 用 GitHub Variables/Secrets。
# church.json 设定路径及建置指令见 docs/deployment.md。

# ── GitHub Actions：main/dev push会触发，缺自己的设定则fail-fast ───────────
# 正式使用前请依 workflow 的 Secret／Variable 契约设定；不要复制上游的 project。
# GitHub Secret（workflow 由 secrets.CLOUDFLARE_ACCOUNT_ID 读取）
CLOUDFLARE_ACCOUNT_ID=
# GitHub Variable
CLOUDFLARE_PAGES_PROJECT=
# Secret；限定所需帐号与 Pages 部署权限，不可进 Flutter bundle
CLOUDFLARE_API_TOKEN=
# JSON 全文（来自自己的 .local/church.json）；没有任何 server secrets
CHURCH_CONFIG_JSON=
# 选填 GitHub Variable：runner中的PNG资产目录，预设web。
# 客制素材可自行备妥，或用下方固定Git版本还原；不读你电脑的.local。
CHURCH_ASSETS_DIR=web
# 选填：完整40hex commit SHA；空值不启用Git取图。
# 仅适用素材已在自己的Git历史且有权使用；CI只从本repo的origin取得。
# 启用时CHURCH_ASSETS_DIR必须改为gitignored .local子目录，例如.local/branding。
CHURCH_ASSETS_GIT_REF=

# ── Firebase Web build 设定：会公开在浏览器，不是 server credentials ───────
# GitHub Variables / 本机 .local/firebase-web.json；与自己的 Firebase Web app 一致
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# 选用 Google Calendar 前端读取；calendar=true 才需要。
# API key 最终会公开：限制 HTTP referrers 及 Google Calendar API 用途。
# 日历须能公开读取；不支援以此 API key 读私密日历。
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# 选用 FCM 接收：这是 VAPID 公钥，不是私钥；pushNotifications=true 才需要。
FCM_WEB_VAPID_KEY=

# ── Cloudflare Pages 执行期：Production / Preview 分开设 ─────────────────
# 与 build 使用相同 Firebase project；勿把前端 key 当作资料授权。
# FIREBASE_PROJECT_ID=
# GOOGLE_CALENDAR_ID=
# 共用 ChurchConfig 由 staging 产生 worker/generated_config.js；不要用不同设定覆盖。

# Secret：日历写入用 service account JSON，绝不可 --dart-define 或提交到 Git。
# 日历另分享给 service account email（变更活动）。
GOOGLE_SERVICE_ACCOUNT_JSON=

# Secret：选用照片辨识的 Gemini key，只能放 Cloudflare 执行期。
# 部署者自行确认隐私／配额／付款设定；不保证免费或可用。
GEMINI_API_KEY=
# 选填：依 worker/gemini.js 支援的模型自行测试；留空使用程式预设。
GEMINI_MODEL=

# 自行架设的 LINE/n8n 相容通知接收端（选用），请勿让 Preview 误发正式群组。
# webhook 必须验证 x-notify-secret。URL 若含凭证也须当作 Secret。
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# ── 选用 GitHub 灵粮 workflow，统一读上面的 CHURCH_CONFIG_JSON ───────────
# devotional.enabled=true 且 fetchUrl 非空才抓取。
# devotional.fetchFormat: json（预设）或 dailyBibleHtml（既有固定版型adapter）。
# 日期使用同份设定的 timeZone；cron本身仍以UTC计算。
# dataUrl=App读JSON的位置，linkUrl=点击网站，fetchUrl=workflow抓取来源。
# 不另设独立feed URL／时区变数，避免三端设定漂移；HTTPS验证不可跳过。

# ── 限制功能的Docker/nginx路线 ───────────────────────────────────────────
# docker compose build同样需要CHURCH_CONFIG_JSON build-arg。
# 静态nginx不跑Pages Functions；calendar/photoImport/lineNotifications须关闭。

# ── 仅本机 bootstrap --apply 使用，不是 App 设定 ─────────────────────────
# 预设使用 gcloud ADC；需要时才提供短期 OAuth token，不要提交或写入CI log。
# GOOGLE_OAUTH_ACCESS_TOKEN=
